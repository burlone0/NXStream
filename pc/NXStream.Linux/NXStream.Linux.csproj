<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>nxstream</AssemblyName>
    <RootNamespace>NXStream</RootNamespace>
    <Version>1.0.0</Version>
    <Product>NXStream</Product>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\NXStream\Protocol\*.cs" Link="Shared\Protocol\%(Filename)%(Extension)" />
    <Compile Include="..\NXStream\Net\*.cs" Link="Shared\Net\%(Filename)%(Extension)" />
    <Compile Include="..\NXStream\Core\*.cs" Link="Shared\Core\%(Filename)%(Extension)" />
    <Compile Include="..\NXStream\Media\H264Decoder.cs;..\NXStream\Media\H264ParameterCache.cs;..\NXStream\Media\H264Sps.cs;..\NXStream\Media\FfmpegLocator.cs;..\NXStream\Media\ChildProcessGuard.cs;..\NXStream\Media\JitterBuffer.cs;..\NXStream\Media\IAudioSink.cs;..\NXStream\Media\IJpegDecoder.cs;..\NXStream\Media\IMediaFactory.cs" Link="Shared\Media\%(Filename)%(Extension)" />
    <Compile Include="..\NXStream\Render\RenderTypes.cs;..\NXStream\Render\GlShaders.cs;..\NXStream\Render\Gl.cs;..\NXStream\Render\GlRenderer.cs" Link="Shared\Render\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\pc\packaging\linux\nxstream.png" LogicalName="logo.png" />
    <None Include="..\packaging\linux\fonts\*" Link="fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="NXStreamContentId" Value="$(ContentId)" Condition="'$(ContentId)'!=''" />
  </ItemGroup>

</Project>
